# Optional: absolute path of your existing Obsidian vault.
# Life Garden writes only to its dedicated Life Garden subfolder.
# OBSIDIAN_VAULT_PATH=/Users/you/Documents/My Vault
# Optional: relocate the private SQLite database and mirror metadata.
# LIFE_GARDEN_DATA_DIR=/Users/you/Documents/LifeGardenData
# Railway only: mount a persistent volume at /data before deploying.
# LIFE_GARDEN_HOSTED=1
# LIFE_GARDEN_DATA_DIR=/data
# LIFE_GARDEN_USERNAME=garden
# LIFE_GARDEN_PASSWORD_SCRYPT=<hash from npm run create-hosted-access>
# LIFE_GARDEN_ORIGIN=https://your-app.up.railway.app
